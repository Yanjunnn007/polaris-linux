@@ -1119,23 +1126,53 @@ static int imx363_identify_module(struct imx363 *imx363)
 {
 	struct i2c_client *client = v4l2_get_subdevdata(&imx363->sd);
 	int ret;
-	u64 val;
+	u64 val = 0;
+	int attempt;
+	u8 orig_addr = client->addr;
+	u8 candidate_addrs[] = { orig_addr, (orig_addr == 0x1a) ? 0x10 : 0x1a };
+	int a;
+
+	for (a = 0; a < 2; a++) {
+		client->addr = candidate_addrs[a];
+		dev_info(&client->dev, "Starting IMX363 identification on addr 0x%02x...\n", client->addr);
+
+		for (attempt = 0; attempt < 3; attempt++) {
+			ret = cci_read(imx363->regmap, IMX363_REG_CHIP_ID, &val, NULL);
+			if (!ret && val == IMX363_CHIP_ID) {
+				dev_info(&client->dev, "Found IMX363 chip id 0x%04llx on addr 0x%02x (attempt %d)!\n",
+					 val, client->addr, attempt);
+				return 0;
+			}
+
+			dev_info(&client->dev, "Addr 0x%02x attempt %d (ret=%d, val=0x%llx), retrying with reset pulse...\n",
+				 client->addr, attempt, ret, val);
+
+			/* Toggle reset pin pulse */
+		gpiod_set_value_cansleep(imx363->reset_gpio, 1);
+		msleep(5);
+		gpiod_set_value_cansleep(imx363->reset_gpio, 0);
+		msleep(10);
+		}
 
-	ret = cci_read(imx363->regmap, IMX363_REG_CHIP_ID,
-		       &val, NULL);
-	if (ret) {
-		dev_err(&client->dev, "failed to read chip id %x\n",
-			IMX363_CHIP_ID);
-		return ret;
-	}
+		/* Try reading with reset held at 1 (in case polarity in DT is inverted) */
+		gpiod_set_value_cansleep(imx363->reset_gpio, 1);
+		msleep(10);
+		ret = cci_read(imx363->regmap, IMX363_REG_CHIP_ID, &val, NULL);
+		if (!ret && val == IMX363_CHIP_ID) {
+			dev_info(&client->dev, "Found IMX363 on addr 0x%02x with inverted reset=1! chip id: 0x%04llx\n",
+				 client->addr, val);
+			return 0;
+		}
 
-	if (val != IMX363_CHIP_ID) {
-		dev_err(&client->dev, "chip id mismatch: %x!=%llx\n",
-			IMX363_CHIP_ID, val);
-		return -EIO;
+		/* Restore reset to 0 */
+		gpiod_set_value_cansleep(imx363->reset_gpio, 0);
+		msleep(10);
 	}
 
-	return 0;
+	client->addr = orig_addr;
+	dev_err(&client->dev, "failed to read chip id %x (ret=%d, val=0x%llx)\n",
+		IMX363_CHIP_ID, ret, val);
+	return ret ? ret : -EIO;
 }
 
